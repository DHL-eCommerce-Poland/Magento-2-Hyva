<?php

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

$hyvaCsp = $viewModels->require(HyvaCsp::class);
?>
<script>
    function initDhlPointSelector() {
        return {
            baseUrl: '',
            mapUrl: '',
            pointMapType: 'all',
            isCodMethod: false,
            countryCode: 'PL',
            isGermanPackstationMethod: false,
            isPackstationMethod: false,
            isParcelShopMethod: false,
            methodCode: '',
            modalOpen: false,
            pointData: {
                sap: '',
                name: '',
                street: '',
                postcode: '',
                city: '',
                isPackstation: false,
                isPostfiliale: false,
                country: 'PL'
            },
            postnummer: '',
            lastSavedPostnummer: '',
            postnummerTimer: null,
            messageHandler: null,
            configObserver: null,

            init() {
                this.loadConfig();
                this.initMessageListener();
                this.observeConfigChanges();
            },

            destroy() {
                if (this.postnummerTimer) {
                    clearTimeout(this.postnummerTimer);
                    this.postnummerTimer = null;
                }
                if (this.messageHandler) {
                    window.removeEventListener('message', this.messageHandler, false);
                    this.messageHandler = null;
                }
                if (this.configObserver) {
                    this.configObserver.disconnect();
                    this.configObserver = null;
                }
            },

            loadConfig() {
                if (!this.$el || !this.$el.dataset || !this.$el.dataset.config) {
                    return;
                }
                try {
                    const config = JSON.parse(this.$el.dataset.config);
                    if (config.baseUrl) this.baseUrl = config.baseUrl;
                    if (config.mapUrl) this.mapUrl = config.mapUrl;
                    if (config.pointMapType) this.pointMapType = config.pointMapType;
                    if (typeof config.isCodMethod !== 'undefined') this.isCodMethod = Boolean(config.isCodMethod);
                    if (config.countryCode) this.countryCode = config.countryCode;
                    if (typeof config.isGermanPackstation !== 'undefined') {
                        this.isGermanPackstationMethod = Boolean(config.isGermanPackstation);
                    }
                    if (typeof config.isPackstation !== 'undefined') {
                        this.isPackstationMethod = Boolean(config.isPackstation);
                    }
                    if (typeof config.isParcelShop !== 'undefined') {
                        this.isParcelShopMethod = Boolean(config.isParcelShop);
                    }
                    if (config.methodCode) this.methodCode = config.methodCode;
                    this.postnummer = config.postnummer || '';
                    this.lastSavedPostnummer = this.postnummer;
                    if (config.pointData && typeof config.pointData === 'object') {
                        this.pointData = {
                            sap: config.pointData.sap || '',
                            name: config.pointData.name || '',
                            street: config.pointData.street || '',
                            postcode: config.pointData.postcode || '',
                            city: config.pointData.city || '',
                            isPackstation: Boolean(config.pointData.isPackstation),
                            isPostfiliale: Boolean(config.pointData.isPostfiliale),
                            country: config.pointData.country || 'PL'
                        };
                    }
                } catch (e) {
                    console.error('DHL point selector config parse error:', e);
                }
            },

            observeConfigChanges() {
                if (!this.$el || typeof MutationObserver === 'undefined') {
                    return;
                }
                this.configObserver = new MutationObserver((mutations) => {
                    for (const mutation of mutations) {
                        if (mutation.type === 'attributes' && mutation.attributeName === 'data-config') {
                            this.loadConfig();
                        }
                    }
                });
                this.configObserver.observe(this.$el, { attributes: true, attributeFilter: ['data-config'] });
            },

            hasPoint() {
                return Boolean(this.pointData && this.pointData.sap && String(this.pointData.sap).trim().length > 0);
            },

            hasNoPoint() {
                return !this.hasPoint();
            },

            needsPostnummer() {
                return Boolean(
                    this.isGermanPackstationMethod ||
                    this.isPackstationMethod ||
                    (this.pointData && this.pointData.isPackstation && this.pointData.country === 'DE')
                );
            },

            getMapIframeUrl() {
                const baseUrl = this.baseUrl;
                if (!baseUrl) {
                    return this.mapUrl;
                }
                let country = (this.pointData && this.pointData.country)
                    ? this.pointData.country
                    : (this.countryCode || 'PL');

                const formCountry = document.querySelector('select[name="country_id"]')?.value
                    || document.querySelector('[name="country_id"]')?.value;
                if (formCountry) {
                    country = formCountry;
                }

                if (this.isPackstationMethod || this.isGermanPackstationMethod) {
                    country = 'DE';
                } else if (this.isParcelShopMethod && country.toUpperCase() === 'PL') {
                    country = 'DE';
                }

                country = (country || 'PL').toUpperCase();
                const params = [];

                if (country !== 'PL') {
                    params.push('country=' + encodeURIComponent(country));

                    if (this.pointMapType === 'box' || this.isPackstationMethod) {
                        params.push('ptype=packStation');
                    } else if (this.pointMapType === 'pop' || this.isParcelShopMethod) {
                        params.push('ptype=parcelShop');
                    }
                } else {
                    if (this.isCodMethod) {
                        params.push('options_pickup_cod=T');
                    }

                    if (this.pointMapType === 'box') {
                        params.push(
                            'show_on_map_parcelshop=N&show_on_map_parcelshop_late=N&show_on_map_parcelstation=T'
                        );
                    } else if (this.pointMapType === 'pop') {
                        params.push(
                            'show_on_map_parcelshop=T&show_on_map_parcelshop_late=N&show_on_map_parcelstation=N'
                        );
                    }
                }

                const sep = baseUrl.includes('?') ? '&' : '?';
                return params.length ? baseUrl + sep + params.join('&') : baseUrl;
            },

            openModal() {
                this.mapUrl = this.getMapIframeUrl();
                this.modalOpen = true;
            },

            closeModal() {
                this.modalOpen = false;
            },

            onPostnummerInput(event) {
                const val = (event && event.target) ? event.target.value : '';
                this.postnummer = val;
                if (this.postnummerTimer) {
                    clearTimeout(this.postnummerTimer);
                }
                this.postnummerTimer = setTimeout(() => {
                    this.updatePostnummer(val);
                }, 400);
            },

            onPostnummerBlur(event) {
                const val = (event && event.target) ? event.target.value : this.postnummer;
                if (this.postnummerTimer) {
                    clearTimeout(this.postnummerTimer);
                    this.postnummerTimer = null;
                }
                this.updatePostnummer(val);
            },

            updatePostnummer(value) {
                const normalized = (value || '').trim();
                this.postnummer = value;
                if (normalized === this.lastSavedPostnummer) {
                    return;
                }
                this.lastSavedPostnummer = normalized;
                if (typeof this.$wire !== 'undefined' && typeof this.$wire.updatedPostnummer === 'function') {
                    this.$wire.updatedPostnummer(normalized);
                }
            },

            initMessageListener() {
                const self = this;
                this.messageHandler = function (event) {
                    if (!event || !event.data || !self.modalOpen) {
                        return;
                    }

                    let mapOrigin = '';
                    try {
                        mapOrigin = new URL(self.mapUrl, window.location.href).origin;
                    } catch (e) {
                        return;
                    }

                    if (event.origin !== mapOrigin) {
                        return;
                    }

                    let rawData = event.data;
                    if (typeof rawData === 'string') {
                        try {
                            rawData = JSON.parse(rawData);
                        } catch (e) {
                            return;
                        }
                    }

                    if (rawData && typeof rawData === 'object' && rawData.sap) {
                        const sap = rawData.sap || '';
                        const name = rawData.name || sap;
                        let street = rawData.street || '';
                        const houseNo = rawData.streetNo || rawData.houseNo || '';
                        if (houseNo && !street.includes(houseNo)) {
                            street = (street ? street + ' ' : '') + houseNo;
                        }
                        const zip = rawData.zip || rawData.postalCode || '';
                        const city = rawData.city || '';
                        const isIntlPoint = self.isGermanPackstationMethod
                            || self.isPackstationMethod
                            || self.isParcelShopMethod;
                        const defaultCountry = isIntlPoint ? 'DE' : 'PL';
                        const country = (rawData.country || defaultCountry).toUpperCase();

                        const isPackstation = Boolean(self.isPackstationMethod);
                        const isPostfiliale = Boolean(self.isParcelShopMethod);

                        self.pointData = {
                            sap: sap,
                            name: name,
                            street: street,
                            postcode: zip,
                            city: city,
                            isPackstation: isPackstation,
                            isPostfiliale: isPostfiliale,
                            country: country
                        };

                        if (typeof self.$wire !== 'undefined' && typeof self.$wire.selectPoint === 'function') {
                            self.$wire.selectPoint({
                                sap: sap,
                                name: name,
                                street: street,
                                streetNo: houseNo,
                                zip: zip,
                                city: city,
                                country: country,
                                isPackstation: isPackstation,
                                isPostfiliale: isPostfiliale,
                                postnummer: self.postnummer || '',
                                methodCode: self.methodCode || ''
                            });
                        }

                        self.closeModal();
                    }
                };
                window.addEventListener('message', this.messageHandler, false);
            }
        };
    }

    window.initDhlPointSelector = initDhlPointSelector;

    if (typeof Alpine !== 'undefined' && typeof Alpine.data === 'function') {
        Alpine.data('initDhlPointSelector', initDhlPointSelector);
    } else {
        window.addEventListener('alpine:init', () => {
            Alpine.data('initDhlPointSelector', initDhlPointSelector);
        }, { once: true });
    }
</script>
<?php $hyvaCsp->registerInlineScript() ?>
