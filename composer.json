{
    "name": "dhl-poland/module-hyva-dhl",
    "description": "Hyvä Checkout compatibility module for DHL eCommerce Poland",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "DHL eCommerce Poland",
            "email": "pl.cim@dhl.com",
            "homepage": "https://dhl24.com.pl/"
        }
    ],
    "keywords": [
        "magento2",
        "hyva",
        "hyva-checkout",
        "dhl",
        "shipping",
        "parcelshop",
        "packstation",
        "delivery"
    ],
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "dhl-poland/module-dhl": "^1.0",
        "hyva-themes/magento2-hyva-checkout": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0 || ^12.0",
        "magento/magento-coding-standard": "*"
    },
    "suggest": {
        "hyva-themes/magento2-compat-module-fallback": "^1.1: Automatic template fallback and Tailwind CSS discovery"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DhlPoland\\HyvaDhl\\": ""
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
